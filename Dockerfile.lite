FROM python:3.11-slim

WORKDIR /app

# Lightweight deps — no sentence-transformers/torch (~100MB vs ~2GB)
RUN pip install --no-cache-dir \
    fastapi>=0.100.0 \
    uvicorn[standard]>=0.23.0 \
    jinja2>=3.1.0 \
    pydantic>=2.0.0 \
    numpy>=1.24.0 \
    scipy>=1.10.0 \
    httpx>=0.27.0 \
    itsdangerous>=2.1.0 \
    anthropic>=0.90.0

# Copy application code
COPY web_app.py .
COPY process_corpus.py .
COPY tag_passages.py .
COPY extract_scripture_references.py .
COPY generate_embeddings.py .
COPY search_corpus.py .
COPY strangely_warm_index/ strangely_warm_index/
COPY scripts/ scripts/
COPY templates/ templates/
COPY static/ static/
COPY metadata/ metadata/

# Copy corpus data (no embeddings — semantic search/scoring disabled)
COPY chunked/cleaned_passages.jsonl chunked/cleaned_passages.jsonl
COPY cleaned/ cleaned/

EXPOSE 8000

CMD ["uvicorn", "web_app:app", "--host", "0.0.0.0", "--port", "8000"]
